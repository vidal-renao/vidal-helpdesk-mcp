{
  "version": 2,
  "builds": [
    { "src": "api/cron/audit.ts", "use": "@vercel/node" },
    { "src": "api/health/audit.ts", "use": "@vercel/node" },
    { "src": "src/vercel-server.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/cron/audit", "dest": "api/cron/audit.ts" },
    { "src": "/api/health/audit", "dest": "api/health/audit.ts" },
    { "src": "/(.*)", "dest": "src/vercel-server.ts" }
  ]
}
